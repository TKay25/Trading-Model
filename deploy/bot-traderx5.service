[Unit]
Description=BotTraderX5 Deriv auto-trading dashboard + server-side bot
Documentation=https://github.com/yourusername/your-repo-name
# Start only after the network is up (the bot connects to api.derivws.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as a dedicated non-root user (created during setup). Keep this the same
# user that owns /opt/bot so the config/ledger JSON files are writable.
User=bot
Group=bot
WorkingDirectory=/opt/bot
# Env vars (SECRET_KEY, DERIV_APP_ID, DERIV_API_TOKEN, DERIV_ACCOUNT_TYPE, ...)
EnvironmentFile=/opt/bot/.env
Environment=FLASK_DEBUG=0

# SINGLE gthread worker is required (background singletons: live stream,
# balance stream, position monitor, AutoTrader). 2+ workers = 2+ bots trading
# the same account. Threads carry the SSE streams + concurrent Deriv calls.
ExecStart=/opt/bot/.venv/bin/gunicorn app:app --workers 1 --threads 16 --worker-class gthread --timeout 120 --graceful-timeout 30 --keep-alive 5 --bind 0.0.0.0:8000
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=10

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/bot

[Install]
WantedBy=multi-user.target
